# Prefer .env.development.example for local use or .env.production.example for hosted use.
# Local web requests go directly to the backend on port 4000. Never put server secrets here.
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Native builds require an HTTPS backend reachable by the device.
# VITE_NATIVE_API_URL=https://pms.example.com/api/v1
# Public web origin for QR scans made outside the native app; otherwise uses backend PUBLIC_WEB_URL.
# VITE_PUBLIC_WEB_URL=https://pms.example.com
PMS_BACKEND_URL=http://127.0.0.1:4000
